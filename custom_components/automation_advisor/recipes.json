      "need": ["binary_sensor.motion|occupancy", "light"],
      "same_area": true,
      "compile": {
        "trigger_index": 0,
        "trigger": { "platform": "state", "to": "off", "for": { "minutes": 10 } },
        "action_index": 1,
        "action": "light.turn_off"
      }
    },
    {
      "id": "humidity_fan",
      "title": "습하면 같은 방 환풍기 켜기",
